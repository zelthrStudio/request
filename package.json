{
  "name": "@zelthr/request",
  "description": "Simplified HTTP request client. Modern remake of the classic request package.",
  "version": "1.1.2",
  "keywords": [
    "http",
    "https",
    "http2",
    "client",
    "request",
    "simple",
    "util",
    "utility",
    "typescript"
  ],
  "license": "Apache-2.0",
  "author": "zelthrStudio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zelthrStudio/request.git"
  },
  "engines": {
    "node": ">= 18"
  },
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./src/index.d.mts",
        "default": "./src/index.mjs"
      },
      "require": {
        "types": "./src/index.d.ts",
        "default": "./src/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test tests/test-*.js tests/test-*.mjs",
    "lint": "standard",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "standard": "^17.1.0",
    "typescript": "^7.0.2"
  }
}
